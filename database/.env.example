# ====================================================================
# ResearchHub AI - PostgreSQL Database Environment Template
# ====================================================================

# PostgreSQL Credentials & Connection
POSTGRES_DB=researchhub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Full Connection URL for Clients (Node pg, psql, DBeaver)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchhub

# Docker Volume & Data Storage
PGDATA=/var/lib/postgresql/data/pgdata

