# ====================================================================
# ResearchHub AI - Root Unified Environment Template
# ====================================================================

# Stack Environment Mode
NODE_ENV=development

# --------------------------------------------------------------------
# 1. Database (PostgreSQL / Supabase) Configuration
# --------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=researchhub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchhub

# --------------------------------------------------------------------
# 2. Supabase Cloud Configuration
# --------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --------------------------------------------------------------------
# 3. Backend API Server Configuration
# --------------------------------------------------------------------
BACKEND_PORT=5000
PORT=5000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_here_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------
# 4. Google Gemini AI Engine
# --------------------------------------------------------------------
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# --------------------------------------------------------------------
# 5. Frontend Client Configuration
# --------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_APP_NAME="ResearchHub AI"
