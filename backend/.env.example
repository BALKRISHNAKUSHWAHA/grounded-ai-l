# ====================================================================
# ResearchHub AI - Backend Environment Template
# ====================================================================

# Express Server Port
PORT=5000

# Server Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:5173

# ====================================================================
# Database (PostgreSQL / Supabase Postgres) Configuration
# ====================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchhub

# ====================================================================
# Supabase Configuration
# ====================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ====================================================================
# Authentication & Security
# ====================================================================
JWT_SECRET=super_secret_jwt_key_here_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ====================================================================
# Google Gemini AI Configuration
# ====================================================================
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ====================================================================
# File Upload Configuration
# ====================================================================
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
